/**
 * Configuración Wrangler para Cloudflare Workers (`npm run deploy`, `preview`, build OpenNext).
 * No usar para Pages: ahí “ASSETS” está reservado y campos como `images` no aplican.
 *
 * Pages CI usa solo `wrangler.toml` en la raíz (solo pages_build_output_dir + compat).
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "tripverse-web",
	"main": ".open-next/worker.js",
	"compatibility_date": "2024-09-23",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"binding": "ASSETS",
		"directory": ".open-next/assets"
	},
	"images": {
		// Enable image optimization — https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	},
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "tripverse-web"
		}
	],
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true
}
